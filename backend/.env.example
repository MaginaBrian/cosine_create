# Copy to .env and replace these placeholders. Do not commit .env.
SECRET_KEY=change-me-in-development
JWT_SECRET=change-me-jwt-in-development
DATABASE_URL=sqlite:///instance/cosine.db
# cPanel MySQL example:
# DATABASE_URL=mysql+pymysql://USER:PASSWORD@localhost/DBNAME?charset=utf8mb4
CORS_ORIGINS=https://cosinecreate.com,https://www.cosinecreate.com
# Set true only for the first cPanel start if you cannot run `flask seed`.
SEED_IF_EMPTY=false

# Optional. If MAIL_SERVER is empty, progress emails are written to instance/outbox/.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hello@cosinecreate.com
MAIL_USE_TLS=true
